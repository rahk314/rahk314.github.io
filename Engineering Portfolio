  document.getElementById('mTitle').textContent = p.title;
  document.getElementById('mSub').textContent = p.sub;
  document.getElementById('mGallery').innerHTML =
    '<figure class="g-main" style="margin:0"><div>'+p.art+'<figcaption>'+p.gallery[0][0]+' — '+p.gallery[0][1]+'</figcaption></div></figure>'+
