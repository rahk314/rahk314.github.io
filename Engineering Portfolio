<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="data:," />
<title>Rahul Kumar — Engineering Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f4f3ef; --surface:#ffffff; --surface2:#eceae3; --ink:#16181d; --muted:#5b5f6a; --line:#ddd9cf;
    --accent:#b45309; --accent-ink:#92400e; --accent-bg:#fef3c7; --teal:#0f766e; --teal-bg:#ccfbf1;
    --nav-bg:rgba(244,243,239,.92); --shadow:0 12px 32px rgba(22,24,29,.10); --radius:14px;
    color-scheme:light;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#121316; --surface:#1b1d21; --surface2:#24262b; --ink:#f1efe9; --muted:#a7abb6; --line:#33363d;
      --accent:#f59e0b; --accent-ink:#fbbf24; --accent-bg:#3a2c07; --teal:#2dd4bf; --teal-bg:#083f3a;
      --nav-bg:rgba(18,19,22,.92); --shadow:0 12px 32px rgba(0,0,0,.45); color-scheme:dark; }
  }
  *{box-sizing:border-box}
  html{scrollbar-gutter:stable}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:"Manrope",system-ui,sans-serif;line-height:1.55;-webkit-font-smoothing:antialiased}
  button,[role="button"],a.btn{min-height:40px}
  a{color:inherit}
  .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
  /* NAV */
  header{position:sticky;top:0;z-index:40;background:var(--nav-bg);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 0}
  .brand{display:flex;align-items:center;gap:12px;text-decoration:none}
  .mark{width:38px;height:38px;border-radius:9px;background:var(--ink);color:var(--bg);display:grid;place-items:center;font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:13px;letter-spacing:.02em;flex:none}
  .brand b{font-size:15px;letter-spacing:-.01em;display:block;line-height:1.1}
  .brand span{font-size:12px;color:var(--muted);display:block;line-height:1.2}
  nav.tabs{display:flex;gap:4px;flex-wrap:wrap}
  nav.tabs button{appearance:none;border:1px solid transparent;background:transparent;color:var(--muted);font:inherit;font-weight:700;font-size:13.5px;padding:8px 13px;border-radius:999px;cursor:pointer}
  nav.tabs button:hover{color:var(--ink)}
  nav.tabs button[aria-selected="true"]{background:var(--ink);color:var(--bg)}
  /* VIEWS */
  .view{display:none;padding:34px 0 56px}
  .view.active{display:block}
  h1{font-family:"Source Serif 4",Georgia,serif;font-size:clamp(32px,5.2vw,52px);line-height:1.04;letter-spacing:-.01em;margin:0 0 14px;font-weight:600}
  h2{font-size:22px;letter-spacing:-.02em;margin:0 0 8px}
  h3{font-size:15px;margin:0 0 6px}
  .lede{font-size:17px;color:var(--muted);max-width:640px;margin:0}
  .mono{font-family:"IBM Plex Mono",monospace}
  .kicker{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-ink);margin:0 0 12px;font-weight:600}
  /* HERO */
  .hero{display:grid;grid-template-columns:1.35fr .85fr;gap:28px;align-items:start}
  .hero-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px}
  .hero-card h3{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
  .fact{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px dashed var(--line);font-size:13.5px}
  .fact:first-of-type{border-top:none}
  .fact span{color:var(--muted)} .fact b{text-align:right;font-weight:700}
  .chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}
  .chip{font-size:12px;font-weight:700;padding:6px 10px;border-radius:999px;border:1px solid var(--line);background:var(--surface)}
  .chip.hot{background:var(--accent-bg);border-color:transparent;color:var(--accent-ink)}
  .chip.cool{background:var(--teal-bg);border-color:transparent;color:var(--teal)}
  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
  .btn{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font-weight:800;font-size:14px;padding:11px 18px;border-radius:10px;border:1px solid var(--ink);cursor:pointer;font-family:inherit}
  .btn.primary{background:var(--ink);color:var(--bg)}
  .btn.ghost{background:transparent;color:var(--ink)}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:28px}
  .stat{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px}
  .stat b{font-size:22px;letter-spacing:-.02em;display:block}
  .stat span{font-size:12px;color:var(--muted);line-height:1.35;display:block;margin-top:2px}
  .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:38px 0 16px;flex-wrap:wrap}
  .section-head p{color:var(--muted);margin:0;font-size:14px;max-width:520px}
  /* PROJECT CARDS — Tyler-style grid, new palette */
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;text-align:left;padding:0;cursor:pointer;font:inherit;color:inherit;width:100%;transition:transform .15s ease, box-shadow .15s ease}
  .card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
  .card:focus-visible,.btn:focus-visible,nav.tabs button:focus-visible,.thumb:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
  .thumb{height:168px;display:grid;place-items:center;border-bottom:1px solid var(--line);position:relative;overflow:hidden}
  .thumb svg{width:82%;max-width:300px;height:auto}
  .thumb .status{position:absolute;top:10px;left:10px;font-family:"IBM Plex Mono",monospace;font-size:10.5px;font-weight:600;letter-spacing:.06em;padding:4px 8px;border-radius:999px;background:var(--surface);border:1px solid var(--line)}
  .card-body{padding:16px 18px 18px}
  .card-body h3{font-size:17px;letter-spacing:-.01em}
  .card-body p{margin:0;color:var(--muted);font-size:14px}
  .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
  .tag{font-family:"IBM Plex Mono",monospace;font-size:11px;padding:4px 7px;border-radius:6px;background:var(--surface2);color:var(--muted)}
  .open-row{display:flex;justify-content:space-between;align-items:center;margin-top:14px;font-size:13px;font-weight:800;color:var(--accent-ink)}
  /* SKILLS */
  .skill-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .skill{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px}
  .skill ul{margin:10px 0 0;padding-left:18px;color:var(--muted);font-size:14px}
  .skill li{margin:5px 0}
  .bar-row{margin-top:22px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px}
  .bar-row p{color:var(--muted);font-size:14px;margin:4px 0 0}
  /* RESUME / CONTACT */
  .two{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;align-items:start}
  .panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
  .panel p,.panel li{color:var(--muted);font-size:14.5px}
  .panel ul{padding-left:18px;margin:8px 0}
  .timeline{border-left:2px solid var(--line);margin:6px 0 0 4px;padding-left:18px}
  .tl{position:relative;padding:0 0 18px}
  .tl::before{content:"";position:absolute;left:-24px;top:5px;width:10px;height:10px;border-radius:50%;background:var(--accent);border:2px solid var(--bg)}
  .tl b{display:block;font-size:14.5px;color:var(--ink)} .tl span{font-size:12.5px;color:var(--muted);font-family:"IBM Plex Mono",monospace}
  .tl p{margin:4px 0 0;font-size:14px;color:var(--muted)}
  .link-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-top:1px dashed var(--line)}
  .link-row:first-of-type{border-top:none}
  .link-row small{display:block;color:var(--muted);font-size:12px}
  .note{font-size:13px;color:var(--muted);background:var(--surface2);border-radius:10px;padding:12px 14px;margin-top:14px}
  footer{border-top:1px solid var(--line);padding:20px 0 30px;color:var(--muted);font-size:13px}
  footer .wrap{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}
  /* MODAL — Ahren-style detail popup */
  dialog{border:none;padding:0;background:transparent;max-width:min(880px,94vw);width:100%}
  dialog::backdrop{background:rgba(10,10,12,.62);backdrop-filter:blur(3px)}
  .modal{background:var(--surface);color:var(--ink);border-radius:18px;overflow:hidden;max-height:88vh;overflow-y:auto;box-shadow:var(--shadow)}
  .modal-hero{padding:22px 24px 0;display:flex;justify-content:space-between;gap:16px;align-items:flex-start}
  .modal-hero h2{font-size:26px;letter-spacing:-.02em}
  .modal-hero p{color:var(--muted);margin:4px 0 0;font-size:14.5px;max-width:560px}
  .close{flex:none;width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-size:18px;cursor:pointer}
  .gallery{display:grid;grid-template-columns:1.5fr 1fr;gap:10px;padding:18px 24px 0}
  .g-main,.g-side{border:1px solid var(--line);border-radius:12px;background:var(--surface2);display:grid;place-items:center;min-height:170px;padding:14px;text-align:center}
  .g-side{min-height:80px}
  .g-col{display:grid;gap:10px}
  .gallery svg{width:100%;max-width:340px;height:auto}
  .gallery figcaption{font-size:12px;color:var(--muted);margin-top:8px;font-family:"IBM Plex Mono",monospace}
  .modal-body{padding:20px 24px 26px;display:grid;grid-template-columns:1.25fr .75fr;gap:22px}
  .modal-body h3{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink);margin-top:18px}
  .modal-body h3:first-child{margin-top:0}
  .modal-body p,.modal-body li{font-size:14.5px;color:var(--muted)}
  .modal-body ul{padding-left:18px;margin:6px 0}
  .spec{width:100%;border-collapse:collapse;font-size:13.5px}
  .spec td{padding:8px 0;border-top:1px dashed var(--line);vertical-align:top}
  .spec td:first-child{color:var(--muted);padding-right:12px;width:44%}
  .spec td:last-child{font-weight:700;text-align:right}
  @media (max-width:820px){
    .hero,.two,.modal-body{grid-template-columns:1fr}
    .grid{grid-template-columns:1fr}
    .skill-grid{grid-template-columns:1fr}
    .stats{grid-template-columns:1fr 1fr}
    .gallery{grid-template-columns:1fr}
    .brand span{display:none}
    nav.tabs button{padding:8px 10px;font-size:13px}
    .view{padding-top:24px}
  }
  @media (prefers-reduced-motion: reduce){ *{transition:none !important} }
</style>
</head>
<body>
<header>
  <div class="wrap nav">
    <a class="brand" href="#" data-goto="overview"><span class="mark">RK</span><span><b>Rahul Kumar</b><span>Mechanical Engineering · Boston University ’27</span></span></a>
    <nav class="tabs" role="tablist" aria-label="Portfolio sections">
      <button role="tab" aria-selected="true" data-view="overview">Overview</button>
      <button role="tab" aria-selected="false" data-view="projects">Projects</button>
      <button role="tab" aria-selected="false" data-view="skills">Skills</button>
      <button role="tab" aria-selected="false" data-view="resume">Résumé</button>
      <button role="tab" aria-selected="false" data-view="contact">Contact</button>
    </nav>
  </div>
</header>

<main class="wrap">
  <!-- OVERVIEW -->
  <section class="view active" id="view-overview" aria-label="Overview">
    <div class="hero">
      <div>
        <p class="kicker">Boston, MA · Class of 2027</p>
        <h1>I build small machines that sense, think, and move.</h1>
        <p class="lede">Mechanical engineering student at Boston University focused on mechatronics and EVs. I like projects where the CAD, the electronics, and the code all have to agree with each other — and I test until they do.</p>
        <div class="chips">
          <span class="chip hot">Mechatronics</span><span class="chip">Embedded systems</span><span class="chip cool">EV interest</span><span class="chip">Controls / PID</span><span class="chip">3D printing</span>
        </div>
        <div class="actions">
          <button class="btn primary" data-goto="projects">See the projects →</button>
          <button class="btn ghost" data-goto="resume">View résumé</button>
        </div>
        <div class="stats">
          <div class="stat"><b>4</b><span>Featured builds, from tremor-assist to IoT dashboards</span></div>
          <div class="stat"><b>4–9 Hz</b><span>Tremor band the stabilizing utensil is designed to cancel</span></div>
          <div class="stat"><b>5 s</b><span>Live polling interval on the ESP32 climate dashboard</span></div>
          <div class="stat"><b>240 × 240</b><span>Round LCD resolution on the rotary-knob controller</span></div>
        </div>
      </div>
      <aside class="hero-card" aria-label="At a glance">
        <h3>At a glance</h3>
        <div class="fact"><span>School</span><b>Boston University</b></div>
        <div class="fact"><span>Major</span><b>Mechanical Engineering</b></div>
        <div class="fact"><span>Graduating</span><b>Spring 2027</b></div>
        <div class="fact"><span>Focus</span><b>Mechatronics · EVs</b></div>
        <div class="fact"><span>Workshop</span><b>Bambu Lab P1S · ESP32 lab</b></div>
        <div class="fact"><span>Looking for</span><b>Engineering roles after graduation</b></div>
        <p class="note" style="margin-top:14px">Boston-based senior graduating in May 2027, looking for mechanical design and mechatronics roles — especially in EV development — where hardware, firmware, and testing meet.</p>
      </aside>
    </div>

    <div class="section-head">
      <div><h2>Featured project</h2><p>The build that ties together sensing, actuation, power, and product constraints.</p></div>
      <button class="btn ghost" data-goto="projects">All projects →</button>
    </div>
    <button class="card" data-project="utensil" style="width:100%">
      <span class="thumb" style="background:linear-gradient(135deg,#fef3c7,#fde68a)">
        <span class="status">● IN PROGRESS</span>
        <svg viewBox="0 0 320 120" fill="none" stroke="#92400e" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M20 78 C70 40, 110 95, 160 60 S 260 55, 300 62" stroke-dasharray="5 6" opacity=".55"/><rect x="118" y="42" width="120" height="34" rx="17" fill="#fff" /><circle cx="252" cy="59" r="10"/><path d="M262 59 h34 M282 48 v22" /><path d="M60 30 l10 10 M60 40 l10-10" stroke="#0f766e"/></svg>
      </span>
      <span class="card-body" style="display:block">
        <h3>Self-Stabilizing Eating Utensil</h3>
        <p>An IMU + servo utensil handle that counteracts 4–9 Hz hand tremor, with a contact-charging dock and campus-safe cylindrical cells. Click for the full breakdown, specs, and diagrams.</p>
        <span class="tags"><span class="tag">IMU · LSM6DSOX</span><span class="tag">XIAO ESP32-S3</span><span class="tag">Servo control</span><span class="tag">Power design</span></span>
        <span class="open-row"><span>Open project detail</span><span>↗</span></span>
      </span>
    </button>
  </section>

  <!-- PROJECTS -->
  <section class="view" id="view-projects" aria-label="Projects">
    <p class="kicker">Projects</p>
    <h1 style="font-size:clamp(28px,4vw,40px)">Four builds. Click any card for the full story.</h1>
    <p class="lede" style="margin-bottom:22px">Each card is just the preview — problem, approach, and result live in the popup, with extra diagrams, so this page stays short and scannable.</p>
    <p class="note" style="margin-bottom:18px"><b>Draft lineup:</b> these four entries are sketched from your portfolio brief so you can judge the design. Confirm, cut, or swap them once the site is set up — each project is just one card + popup.</p>
    <div class="grid" id="projectGrid"></div>
    <p class="note">How to read these: <b>Problem → What I built → Result.</b> Numbers are the ones from the actual builds — frequencies, intervals, resolutions, and budgets — not rounded marketing claims.</p>
  </section>

  <!-- SKILLS -->
  <section class="view" id="view-skills" aria-label="Skills">
    <p class="kicker">Skills</p>
    <h1 style="font-size:clamp(28px,4vw,40px)">What I can actually do in the lab.</h1>
    <p class="lede" style="margin-bottom:22px">Grouped the way I use them on projects — design it, wire it, code it, print it, test it.</p>
    <div class="skill-grid">
      <div class="skill"><h3>🛠 Design &amp; CAD</h3><ul><li>Mechanical design for handheld / enclosure-scale devices</li><li>Design for 3D printing — tolerances, fits, iteration</li><li>BOM building and component selection under budget + policy constraints</li></ul></div>
      <div class="skill"><h3>⚡ Embedded &amp; Electronics</h3><ul><li>ESP32 (WROOM-32, XIAO ESP32-S3) firmware in Arduino / C</li><li>Sensors: IMU (LSM6DSOX), DHT climate sensing</li><li>Enterprise Wi-Fi debugging — WPA2-Enterprise, PEAP / MSCHAPv2 on eduroam</li><li>Battery systems: 1S Li-ion, protection boards, contact charging</li></ul></div>
      <div class="skill"><h3>🎛 Controls &amp; Software</h3><ul><li>Servo actuation and stabilization concepts for 4–9 Hz disturbance rejection</li><li>Live web dashboards — JSON polling, history charts, gauges</li><li>Rotary-encoder UI (EC11) + round LCD menu systems</li><li>IR capture / replay for closed-loop fan control</li></ul></div>
    </div>
    <div class="bar-row"><h3>Tools on the bench right now</h3><p>Bambu Lab P1S · Arduino Uno R3 + starter kit (28BYJ-48 stepper / ULN2003) · ESP32 DevKit (CP2102) · Soldering + hand tools · Git / GitHub Pages for this site.</p></div>
  </section>

  <!-- RESUME -->
  <section class="view" id="view-resume" aria-label="Résumé">
    <p class="kicker">Résumé — summary view</p>
    <h1 style="font-size:clamp(28px,4vw,40px)">Rahul Kumar</h1>
    <p class="lede" style="margin-bottom:22px">Mechanical Engineering, Boston University — Class of 2027. This page is the web summary; drop your one-page PDF in here when it’s final.</p>
    <div class="two">
      <div class="panel">
        <h3>Education</h3>
        <div class="timeline">
          <div class="tl"><span>2023 — MAY 2027</span><b>B.S. Mechanical Engineering — Boston University</b><p>Final semester: part-time, 3 classes / 10 credits. Focus in mechatronics and electromechanical systems.</p></div>
          <div class="tl"><span>ONGOING</span><b>Self-directed embedded systems study</b><p>ESP32 project ladder: enterprise Wi-Fi → web server → climate dashboard → rotary-knob controller.</p></div>
        </div>
        <h3 style="margin-top:10px">Project experience</h3>
        <ul>
          <li><b style="color:var(--ink)">Self-stabilizing utensil</b> — IMU + servo tremor cancellation (4–9 Hz), 30–50 g load, cylindrical-cell power, charging dock.</li>
          <li><b style="color:var(--ink)">ESP32 climate dashboard</b> — live temp / humidity dashboard on BU eduroam, 5-second JSON polling, 4-hour history.</li>
          <li><b style="color:var(--ink)">Rotary-knob controller</b> — 240×240 round LCD over an EC11 encoder; turn to browse, press to select.</li>
          <li><b style="color:var(--ink)">P1S workshop setup</b> — network bridging and print-workflow mods for a dorm-network printer.</li>
        </ul>
      </div>
      <div>
        <div class="panel">
          <h3>Add your PDF here</h3>
          <p>When your one-page résumé PDF is ready, this is its home on the GitHub Pages version — recruiters expect one click to download.</p>
          <div class="note">Placeholder on purpose: no PDF was provided for this draft, so there’s no fake download button. Add the file as <span class="mono">resume.pdf</span> in the repo and link it here.</div>
          <h3 style="margin-top:18px">Publishing — GitHub Pages, step by step</h3>
          <p>New to GitHub? This is the whole route, in order:</p>
          <ul>
            <li><b style="color:var(--ink)">1.</b> Create a free account at github.com</li>
            <li><b style="color:var(--ink)">2.</b> New repository named <span class="mono">&lt;your-username&gt;.github.io</span> — that exact name is what turns on Pages</li>
            <li><b style="color:var(--ink)">3.</b> Upload this page as <span class="mono">index.html</span> (Add file → Upload files — no command line needed)</li>
            <li><b style="color:var(--ink)">4.</b> Add <span class="mono">resume.pdf</span> and your real project photos the same way</li>
            <li><b style="color:var(--ink)">5.</b> Open <span class="mono">https://&lt;your-username&gt;.github.io</span> — it’s live in about a minute</li>
            <li><b style="color:var(--ink)">6.</b> Later: point a custom domain (~$12/yr) at it in Settings → Pages</li>
          </ul>
          <p class="note">Project lineup is a draft: these are the four builds from your Nov 11 brief. Tell me which projects you actually want featured and they swap in — each one is just a card + popup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="view" id="view-contact" aria-label="Contact">
    <p class="kicker">Contact</p>
    <h1 style="font-size:clamp(28px,4vw,40px)">Let’s talk engineering.</h1>
    <p class="lede" style="margin-bottom:22px">Best for internships, post-graduation roles (graduating spring 2027), and project conversations — especially EVs and mechatronics.</p>
    <div class="two">
      <div class="panel">
        <div class="link-row"><div><b>Email</b><small>Add your preferred email in the GitHub version</small></div><span class="tag">TO ADD</span></div>
        <div class="link-row"><div><b>GitHub</b><small>Add your github.com profile link</small></div><span class="tag">TO ADD</span></div>
        <div class="link-row"><div><b>LinkedIn</b><small>Add your LinkedIn profile link</small></div><span class="tag">TO ADD</span></div>
        <p class="note">Your email, GitHub username, and LinkedIn URL weren’t in the brief, so they’re left as honest placeholders here rather than invented links. Send them over and they slot straight in.</p>
